{
  "name": "bossa-ai-os",
  "version": "0.2.0",
  "private": true,
  "description": "Multi-tenant Hospitality OS platform. BOSSA Asado i Mar (Tenant 001) and Papai Since 1933 (Tenant 002) run from one Next.js codebase.",
  "scripts": {
    "dev": "next dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run lint && npm run typecheck && npm run test && npm run build",
    "legacy:dashboard": "npm --prefix legacy/static-dashboard run dev",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:test": "supabase test db",
    "supabase:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "kpi:generate": "tsx scripts/generate-kpi-snapshots.ts",
    "ai:evaluate": "tsx scripts/evaluate-ai-executive.ts",
    "bootstrap:production-tenants": "tsx scripts/bootstrap-production-tenants.ts"
  },
  "dependencies": {
    "next": "15.5.20",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.47.10",
    "server-only": "^0.0.1",
    "zod": "^3.24.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "lucide-react": "^0.469.0",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.20",
    "@eslint/eslintrc": "^3.2.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.10",
    "autoprefixer": "^10.4.20",
    "tailwindcss-animate": "^1.0.7",
    "vitest": "^4.1.10",
    "@vitejs/plugin-react": "^4.3.4",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "jsdom": "^25.0.1",
    "@playwright/test": "^1.49.1",
    "tsx": "^4.19.2"
  }
}
